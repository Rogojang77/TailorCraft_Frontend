{
  "expo": {
    "name": "Tailor Craft",
    "slug": "tailor-craft",
    "version": "1.1.3",
    "orientation": "default",
    "icon": "./assets/images/Logo_primary.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/images/Logo_black.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-image-picker",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Tailor Craft to use Face ID to sign in quickly."
        }
      ],
      "expo-apple-authentication",
      "expo-notifications",
      "react-native-iap",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "com.rogojang77.tailorcraft",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO"
      ],
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 23
    },
    "ios": {
      "bundleIdentifier": "com.rogojang77.tailorcraft",
      "buildNumber": "32",
      "supportsTablet": true,
      "appleTeamId": "5Z9B528SHU"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9db59b61-0052-43cb-aa09-90f9d2547c0c"
      }
    },
    "owner": "rogojang77"
  }
}
