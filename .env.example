# Backend API URL
# For local development with the backend running on your machine
# EXPO_PUBLIC_API_URL=http://localhost:3001

# For testing on a physical device, use your machine's IP address
# EXPO_PUBLIC_API_URL=http://192.168.1.x:3001

# For production, use your deployed backend URL (EAS production builds use eas.json env)
# API base; paths like /api/auth/login are appended. Full API root: https://tailorcraft.rogojan.at/api/
EXPO_PUBLIC_API_URL=https://tailorcraft.rogojan.at
